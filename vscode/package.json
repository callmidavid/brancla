{
  "name": "brancla-vscode",
  "displayName": "Brancla - Dead Branch Sweeper",
  "description": "Sync local database with GitHub/GitLab to safely sweep dead remote branches without losing unmerged work.",
  "version": "1.0.2",
  "publisher": "brancla",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/callmidavid/brancla.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.git",
    "onView:branclaSidebarView",
    "onCommand:brancla.scanWorkspace",
    "onCommand:brancla.cleanDeadBranches",
    "onCommand:brancla.restoreBranch",
    "onCommand:brancla.installCli",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:shellscript",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brancla-container",
          "title": "Brancla Branch Sweeper",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "brancla-container": [
        {
          "type": "webview",
          "id": "branclaSidebarView",
          "name": "Dead Branch Sweeper",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "brancla.scanWorkspace",
        "title": "Brancla: Scan Workspace for Dead Branches",
        "icon": "$(refresh)"
      },
      {
        "command": "brancla.cleanDeadBranches",
        "title": "Brancla: Clean Dead Branches Safely",
        "icon": "$(trash)"
      },
      {
        "command": "brancla.restoreBranch",
        "title": "Brancla: Restore Deleted Branch",
        "icon": "$(discard)"
      },
      {
        "command": "brancla.installCli",
        "title": "Brancla: Install or Repair CLI",
        "icon": "$(cloud-download)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:binaries": "node scripts/build-binaries.js",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
